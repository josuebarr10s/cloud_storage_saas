# ==========================================================
# Nimbox Cloud Storage - Variables de Entorno (Plantilla)
# Copia este archivo a .env.local en desarrollo o configura
# estas variables en Vercel > Settings > Environment Variables
# NUNCA coloques aquí la clave service_role de Supabase.
# ==========================================================

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica_aqui

# La clave de DeepSeek (Box IA) NO va aquí: es un secreto de Supabase (DEEPSEEK_API_KEY)
# que solo usa la Edge Function supabase/functions/box-ia.
